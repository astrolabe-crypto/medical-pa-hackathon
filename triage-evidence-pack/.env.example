# Copy to .env and fill only the providers you intend to use. Never commit .env.
# The Finder launcher reads this file and starts live mode when both Anthropic
# and ElevenLabs keys below are present; otherwise it starts deterministic mock mode.

# Live companion conversation
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
DEMO_LLM_PROVIDER=anthropic
DEMO_CHAT_MODEL=claude-haiku-4-5

# Speech-to-text and optional server-side voice
ELEVENLABS_API_KEY=
DEMO_STT_PROVIDER=elevenlabs
DEMO_STT_MODEL=scribe_v2
DEMO_TTS_PROVIDER=elevenlabs
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5

# Optional: set DEMO_START_MODE=mock in your shell for an offline rehearsal.
